# Bookstore Inventory - environment variables (template).
# Copy this file to config.env and fill in real values.
# Parsed by the setup steps in file2.md.

# PostgreSQL connection used by file111.py
DATABASE_URL=postgresql://bookstore_user:CHANGE_ME@localhost:5432/bookstore

# Public URL of the API, used by the frontend (file122.js)
API_PUBLIC_URL=http://localhost:8000

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Restock alert threshold: a report row is flagged when stock falls below it
LOW_STOCK_THRESHOLD=5

# Support contact shown on the storefront page
SUPPORT_EMAIL=support@example.com
